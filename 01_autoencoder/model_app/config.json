{
  "model_file": "model.onnx",
  "model_name": "conv_64",
  "task": "anomaly detection by reconstruction error + similarity search on the latent vector",
  "input": {
    "name": "image",
    "shape": [
      null,
      1,
      64,
      64
    ],
    "dtype": "float32"
  },
  "preprocessing": {
    "steps": [
      "convert to greyscale (PIL 'L')",
      "resize to 64x64",
      "scale to 0-1 (pixel / 255)",
      "invert: x = 1 - x (object bright on dark)"
    ],
    "img_size": 64,
    "invert": true
  },
  "outputs": {
    "reconstruction": "[batch, 1, 64, 64]",
    "latent": "[batch, 64]",
    "score": "[batch] MSE divided by the object's pixel mass (mean pixel + 0.001)"
  },
  "threshold": 0.0335698276758194,
  "threshold_rule": "95th percentile of the score (MSE / pixel mass) on validation normal images",
  "decision": "score > threshold -> 'unusual object, check it'",
  "normal_classes": [
    "IfcAirTerminal",
    "IfcBeam",
    "IfcCableCarrierFitting",
    "IfcCableCarrierSegment",
    "IfcDoor",
    "IfcDuctFitting",
    "IfcDuctSegment",
    "IfcFurniture",
    "IfcLamp",
    "IfcOutlet",
    "IfcPipeFitting",
    "IfcPipeSegment",
    "IfcPlate",
    "IfcSanitaryTerminal",
    "IfcSlab",
    "IfcSpaceHeater",
    "IfcValve",
    "IfcWall"
  ],
  "anomaly_classes_used_in_eval": [
    "IfcStair",
    "IfcRailing"
  ],
  "metrics_test": {
    "roc_auc": 0.89,
    "precision": 0.459,
    "recall": 0.641,
    "test_mse": 0.00056
  },
  "similarity": {
    "gallery_file": "gallery.npz",
    "embedding": "latent output, L2-normalised: e = z / ||z||",
    "metric": "cosine similarity = dot product of embeddings",
    "top_k": 5,
    "precision_at_5_test": 0.533,
    "baseline_raw_pixels": 0.504,
    "chance": 0.063
  }
}